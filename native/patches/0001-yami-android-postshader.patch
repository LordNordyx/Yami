@@ -1030,9 +1033,86 @@ struct GraphicsPrivate {
     }
     
 private:
+    /* [yami] post-processing state */
+    PostShader *postShader = nullptr;
+    bool postShaderFailed = false;
+    TEXFBO postBuffer;
+    Vec2i postBufferSize = Vec2i(0, 0);
+
+    bool postShaderActive() {
+        const std::string &path = threadData->config.postShader;
+        if (path.empty() || postShaderFailed)
+            return false;
+        if (!postShader) {
+            try {
+                postShader = new PostShader(path);
+            } catch (const Exception &e) {
+                Debug() << "[yami] post shader disabled:" << e.msg;
+                postShaderFailed = true;
+                return false;
+            }
+        }
+        return true;
+    }
+
+    void ensurePostBuffer(const Vec2i &size) {
+        if (postBufferSize.x == size.x && postBufferSize.y == size.y)
+            return;
+        if (postBufferSize.x != 0)
+            TEXFBO::fini(postBuffer);
+        TEXFBO::init(postBuffer);
+        TEXFBO::allocEmpty(postBuffer, size.x, size.y);
+        TEXFBO::linkFBO(postBuffer);
+        postBufferSize = size;
+    }
+
+    void presentPostBuffer(const Vec2i &size) {
+        FBO::bind(FBO::ID(0));
+        glState.viewport.pushSet(IntRect(0, 0, size.x, size.y));
+        FBO::clear();
+
+        PostShader &shader = *postShader;
+        shader.bind();
+        shader.applyViewportProj();
+        shader.setTranslation(Vec2i());
+        shader.setTexSize(size);
+        shader.setParams(Vec2(size.x, size.y), Vec2(scRes.x, scRes.y),
+                         Vec4(scOffset.x, scOffset.y, scSize.x, scSize.y),
+                         (float) frameCount,
+                         (float) threadData->config.postShaderIntensity);
+
+        TEX::bind(postBuffer.tex);
+        TEX::setSmooth(true);
+        glState.blend.pushSet(false);
+        Quad &quad = shState->gpQuad();
+        quad.setTexPosRect(IntRect(0, 0, size.x, size.y), IntRect(0, 0, size.x, size.y));
+        quad.draw();
+        glState.blend.pop();
+        TEX::setSmooth(false);
+        glState.viewport.pop();
+    }
+
     template <typename... Args> void swapGLBufferImpl(const Vec2i &screenSize, TEXFBO &source, int scaleIsSpecial, Args... args) {
         fpsLimiter.delay();
 
+        if (postShaderActive()) {
+            /* Upscale into an offscreen buffer first, then run the user
+             * shader over it while presenting to the default framebuffer. */
+            ensurePostBuffer(screenSize);
+            GLMeta::blitBegin(postBuffer, false, scaleIsSpecial);
+            GLMeta::blitSource(source, scaleIsSpecial);
+            FBO::clear();
+            metaBlitBufferFlippedScaled(args...);
+            GLMeta::blitEnd();
+
+            presentPostBuffer(screenSize);
+            SDL_GL_SwapWindow(threadData->window);
+
+            ++frameCount;
+            threadData->ethread->notifyFrame();
+            return;
+        }
+
         GLMeta::blitBeginScreen(screenSize, scaleIsSpecial);
         GLMeta::blitSource(source, scaleIsSpecial);
 
