+/* Yami: the path cache is kept on disk (per game, in YAMI_DATA_DIR). Listing
+ * a big game on Android shared storage (FUSE) takes a long time on every
+ * start; the saved list is reused while every directory keeps its
+ * modification time (adding, removing or renaming a file changes it). */
+static std::string yamiPathCacheFile() {
+  const char *d = getenv("YAMI_DATA_DIR");
+  if (!d || !*d)
+    return std::string();
+  return std::string(d) + "/pathcache.v1";
+}
+
+static PHYSFS_sint64 yamiDirMTime(const std::string &mixed) {
+  PHYSFS_Stat st;
+  if (!PHYSFS_stat(mixed.c_str(), &st))
+    return -2;
+  return st.modtime;
+}
+
+static bool yamiLoadPathCache(FileSystemPrivate *p) {
+  const std::string fn = yamiPathCacheFile();
+  if (fn.empty())
+    return false;
+  FILE *f = fopen(fn.c_str(), "rb");
+  if (!f)
+    return false;
+
+  bool ok = false;
+  char *line = 0;
+  size_t cap = 0;
+  ssize_t len;
+  size_t dirs = 0, files = 0;
+
+  if ((len = getline(&line, &cap, f)) > 0 && strcmp(line, "YAMIPC1\n") == 0) {
+    ok = true;
+    p->fileLists[""];
+    while ((len = getline(&line, &cap, f)) > 0) {
+      if (line[len - 1] == '\n')
+        line[--len] = 0;
+      if (len >= 2 && line[0] == 'F' && line[1] == '\t') {
+        std::string mixed(line + 2);
+        std::string lower = mixed;
+        strTolower(lower);
+        size_t slash = lower.rfind('/');
+        std::string dir = slash == std::string::npos ? std::string() : lower.substr(0, slash);
+        std::string name = slash == std::string::npos ? lower : lower.substr(slash + 1);
+        p->fileLists[dir].push_back(name);
+        p->pathCache.insert(lower, mixed);
+        ++files;
+      } else if (len >= 2 && line[0] == 'D' && line[1] == '\t') {
+        char *tab = strchr(line + 2, '\t');
+        if (!tab) { ok = false; break; }
+        *tab = 0;
+        long long mt = strtoll(line + 2, 0, 10);
+        std::string mixed(tab + 1);
+        if ((long long)yamiDirMTime(mixed) != mt) { ok = false; break; }
+        std::string lower = mixed;
+        strTolower(lower);
+        p->fileLists[lower];
+        p->yamiDirs.push_back(mixed);
+        ++dirs;
+      } else {
+        ok = false;
+        break;
+      }
+    }
+  }
+  free(line);
+  fclose(f);
+
+  if (!ok) {
+    p->fileLists.clear();
+    p->pathCache.clear();
+    p->yamiDirs.clear();
+    Debug() << "Saved path cache out of date, rescanning";
+    return false;
+  }
+  Debug() << "Path cache loaded from disk:" << files << "files," << dirs << "folders";
+  return true;
+}
+
+static void yamiSavePathCache(FileSystemPrivate *p) {
+  const std::string fn = yamiPathCacheFile();
+  if (fn.empty())
+    return;
+  const std::string tmp = fn + ".tmp";
+  FILE *f = fopen(tmp.c_str(), "wb");
+  if (!f)
+    return;
+  fputs("YAMIPC1\n", f);
+  for (size_t i = 0; i < p->yamiDirs.size(); ++i)
+    fprintf(f, "D\t%lld\t%s\n", (long long)yamiDirMTime(p->yamiDirs[i]), p->yamiDirs[i].c_str());
+  for (BoostHash<std::string, std::string>::const_iterator it = p->pathCache.cbegin();
+       it != p->pathCache.cend(); ++it)
+    fprintf(f, "F\t%s\n", it->second.c_str());
+  bool good = fflush(f) == 0;
+  good = (fclose(f) == 0) && good;
+  if (good)
+    rename(tmp.c_str(), fn.c_str());
+  else
+    remove(tmp.c_str());
+}
