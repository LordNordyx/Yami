+/* [yami] Ruby 1.8 compatibility: RGSS1 games were written for Ruby 1.8. When a
+ * script fails to compile, give Yami.fix_script(source, name, message) a chance
+ * to translate it; a SyntaxError means nothing in the script ran, so retrying
+ * is safe. Returns the translated source, or Qnil to keep the original error. */
+static VALUE yamiFixHelper(VALUE args) {
+    VALUE *a = (VALUE*)args;
+    return rb_funcall(a[0], rb_intern("fix_script"), 3, a[1], a[2], a[3]);
+}
+
+static VALUE yamiFixScript(VALUE src, VALUE fname) {
+    VALUE err = rb_errinfo();
+    if (NIL_P(err) || !rb_obj_is_kind_of(err, rb_eSyntaxError))
+        return Qnil;
+    if (!rb_const_defined(rb_cObject, rb_intern("Yami")))
+        return Qnil;
+    VALUE mod = rb_const_get(rb_cObject, rb_intern("Yami"));
+    if (!rb_respond_to(mod, rb_intern("fix_script")))
+        return Qnil;
+    VALUE a[4] = {mod, src, fname, rb_funcall(err, rb_intern("message"), 0)};
+    int st = 0;
+    VALUE fixed = rb_protect(yamiFixHelper, (VALUE)a, &st);
+    if (st || !RB_TYPE_P(fixed, T_STRING)) {
+        rb_set_errinfo(err); /* keep the original error for the message box */
+        return Qnil;
+    }
+    return fixed;
+}
+
