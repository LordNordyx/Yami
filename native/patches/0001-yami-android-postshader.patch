index 770514a..6b80ebe 100644
--- a/binding/table-binding.cpp
+++ b/binding/table-binding.cpp
@@ -154,6 +154,57 @@ RB_METHOD_GUARD(tableSetAt) {
 }
 RB_METHOD_GUARD_END
 
+/* Yami: compact-tileset remap for the GPU map renderer. Rows of the tileset
+ * (8 tiles each, ids >= 384) used by this map get consecutive new rows in
+ * first-seen order; rows at or past maxRow become 0. Returns [rows, data]:
+ * the old row of each new row, and the remapped table in Table._load form.
+ * One native pass instead of tens of thousands of Ruby calls per map load. */
+RB_METHOD(tableYamiRemapRows) {
+  RB_UNUSED_PARAM;
+  Table *t = getPrivateData<Table>(self);
+  int maxRow = argc > 0 ? NUM2INT(argv[0]) : 0;
+  if (maxRow < 0)
+    maxRow = 0;
+  const int xs = t->xSize(), ys = t->ySize(), zs = t->zSize();
+  std::vector<int> newRow((size_t)maxRow, -1);
+  std::vector<int> order;
+  for (int z = 0; z < zs; ++z)
+    for (int y = 0; y < ys; ++y)
+      for (int x = 0; x < xs; ++x) {
+        int id = t->at(x, y, z);
+        if (id < 384)
+          continue;
+        int r = (id - 384) >> 3;
+        if (r < maxRow && newRow[r] < 0) {
+          newRow[r] = (int)order.size();
+          order.push_back(r);
+        }
+      }
+  Table out(xs, ys, zs);
+  for (int z = 0; z < zs; ++z)
+    for (int y = 0; y < ys; ++y)
+      for (int x = 0; x < xs; ++x) {
+        int id = t->at(x, y, z);
+        int v = id;
+        if (id >= 384) {
+          int r = (id - 384) >> 3;
+          v = (r < maxRow && newRow[r] >= 0) ? 384 + (newRow[r] << 3) + ((id - 384) & 7) : 0;
+        } else if (id < 0) {
+          v = 0;
+        }
+        out.at(x, y, z) = (int16_t)v;
+      }
+  VALUE rows = rb_ary_new_capa((long)order.size());
+  for (size_t i = 0; i < order.size(); ++i)
+    rb_ary_push(rows, INT2NUM(order[i]));
+  VALUE data = rb_str_new(0, out.serialSize());
+  out.serialize(RSTRING_PTR(data));
+  VALUE pair = rb_ary_new_capa(2);
+  rb_ary_push(pair, rows);
+  rb_ary_push(pair, data);
+  return pair;
+}
+
 MARSH_LOAD_FUN(Table)
 INITCOPY_FUN(Table)
 
