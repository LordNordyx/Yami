+            if (state) {
+                VALUE fixed = yamiFixScript(string, fname);
+                if (!NIL_P(fixed)) {
+                    rb_set_errinfo(Qnil);
+                    evalString(fixed, fname, &state);
+                }
+            }
             if (state)
                 break;
         }
