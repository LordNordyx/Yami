+PostShader::PostShader(const std::string &fragPath)
+{
+	std::string frag;
+	if (!readFile(fragPath.c_str(), frag))
+		throw Exception(Exception::MKXPError,
+		                "Unable to read post shader '%s'", fragPath.c_str());
+
+	Shader::init(mkxp_shader_simple_vert, mkxp_shader_simple_vert_len,
+	             (const unsigned char*) frag.c_str(), (int) frag.size(),
+	             "simple", fragPath.c_str(), "PostShader");
+
+	ShaderBase::init();
+
+	GET_U(outputSize);
+	GET_U(inputSize);
+	GET_U(viewRect);
+	GET_U(frameCount);
+	GET_U(intensity);
+}
+
+void PostShader::setParams(const Vec2 &outputSize, const Vec2 &inputSize,
+                           const Vec4 &viewRect, float frame, float intensity)
+{
+	if (u_outputSize >= 0) gl.Uniform2f(u_outputSize, outputSize.x, outputSize.y);
+	if (u_inputSize >= 0)  gl.Uniform2f(u_inputSize, inputSize.x, inputSize.y);
+	if (u_viewRect >= 0)   gl.Uniform4f(u_viewRect, viewRect.x, viewRect.y, viewRect.z, viewRect.w);
+	if (u_frameCount >= 0) gl.Uniform1f(u_frameCount, frame);
+	if (u_intensity >= 0)  gl.Uniform1f(u_intensity, intensity);
+}
