+/* ===== Yami: decoded-image cache =========================================
+ * Games load character graphics the moment a sprite appears (overworld
+ * Pokémon, followers, NPCs): open through Android's shared-storage layer,
+ * PNG decode and upload in the middle of a frame (visible hitch). A low
+ * priority thread decodes Graphics/Characters ahead of time within a memory
+ * budget; a load then costs a memcpy and the texture upload. */
+namespace {
+struct YamiImageCache {
+  std::mutex mtx;
+  std::unordered_map<std::string, SDL_Surface *> map;
+  size_t bytes = 0;
+  size_t budget = 0;
+  std::atomic<bool> stop{false};
+  std::atomic<bool> started{false};
+  std::thread worker;
+  /* raw bytes of Data/ files */
+  std::unordered_map<std::string, std::string> data;
+  size_t dataBytes = 0;
+  /* written by the game since start: never served from memory */
+  std::unordered_set<std::string> dirty;
+};
+YamiImageCache yamiImg;
+
+std::string yamiImageKey(const char *filename) {
+  std::string k(filename);
+  for (size_t i = 0; i < k.size(); ++i) {
+    char c = k[i];
+    k[i] = c == '\\' ? '/' : (char)tolower((unsigned char)c);
+  }
+  size_t slash = k.rfind('/');
+  size_t dot = k.rfind('.');
+  if (dot != std::string::npos && (slash == std::string::npos || dot > slash)) {
+    std::string ext = k.substr(dot + 1);
+    if (ext == "png" || ext == "jpg" || ext == "jpeg" || ext == "bmp")
+      k.erase(dot);
+  }
+  while (k.compare(0, 2, "./") == 0)
+    k.erase(0, 2);
+  return k;
+}
+
+size_t yamiImageBudget() {
+  const char *env = getenv("YAMI_IMAGE_CACHE_MB");
+  if (env && *env)
+    return (size_t)std::max(0L, strtol(env, 0, 10)) * 1024 * 1024;
+  long pages = sysconf(_SC_PHYS_PAGES), psize = sysconf(_SC_PAGE_SIZE);
+  size_t ram = (pages > 0 && psize > 0) ? (size_t)pages * (size_t)psize : (size_t)2048 << 20;
+  size_t b = ram / 4;
+  return std::min(b, (size_t)512 << 20);
+}
+
+/* Data/ first (map transfers read them), then character graphics */
+void yamiDataWorker(const std::vector<std::string> &files) {
+  size_t budget = std::min(yamiImg.budget / 2, (size_t)256 << 20);
+  size_t n = 0;
+  for (size_t i = 0; i < files.size() && !yamiImg.stop; ++i) {
+    PHYSFS_File *fh = PHYSFS_openRead(files[i].c_str());
+    if (!fh)
+      continue;
+    PHYSFS_sint64 len = PHYSFS_fileLength(fh);
+    if (len <= 0 || (size_t)len > budget) {
+      PHYSFS_close(fh);
+      continue;
+    }
+    std::string buf((size_t)len, '\0');
+    PHYSFS_sint64 got = PHYSFS_readBytes(fh, &buf[0], (PHYSFS_uint64)len);
+    PHYSFS_close(fh);
+    if (got != len)
+      continue;
+    std::lock_guard<std::mutex> lk(yamiImg.mtx);
+    if (yamiImg.dataBytes + (size_t)len > budget)
+      break;
+    std::string key = yamiImageKey(files[i].c_str());
+    if (yamiImg.data.count(key) || yamiImg.dirty.count(key))
+      continue; /* saved by the game meanwhile: the file is newer */
+    yamiImg.dataBytes += (size_t)len;
+    yamiImg.data[key].swap(buf);
+    ++n;
+  }
+  Debug() << "Data cache:" << n << "files," << (int)(yamiImg.dataBytes >> 20) << "MB";
+}
+
+void yamiImageWorker(std::vector<std::string> dataFiles, std::vector<std::string> files) {
+#ifdef __ANDROID__
+  setpriority(PRIO_PROCESS, gettid(), 10);
+#endif
+  yamiDataWorker(dataFiles);
+  size_t loaded = 0;
+  for (size_t i = 0; i < files.size() && !yamiImg.stop; ++i) {
+    const std::string &path = files[i];
+    const std::string key = yamiImageKey(path.c_str());
+    {
+      std::lock_guard<std::mutex> lk(yamiImg.mtx);
+      if (yamiImg.map.count(key))
+        continue;
+    }
+    PHYSFS_File *fh = PHYSFS_openRead(path.c_str());
+    if (!fh)
+      continue;
+    PHYSFS_sint64 len = PHYSFS_fileLength(fh);
+    if (len <= 0 || len > (64 << 20)) {
+      PHYSFS_close(fh);
+      continue;
+    }
+    std::vector<unsigned char> buf((size_t)len);
+    PHYSFS_sint64 got = PHYSFS_readBytes(fh, buf.data(), (PHYSFS_uint64)len);
+    PHYSFS_close(fh);
+    if (got != len)
+      continue;
+    SDL_RWops *rw = SDL_RWFromConstMem(buf.data(), (int)len);
+    if (!rw)
+      continue;
+    SDL_Surface *s = IMG_Load_RW(rw, 1);
+    if (!s)
+      continue;
+    SDL_Surface *c = SDL_ConvertSurfaceFormat(s, SDL_PIXELFORMAT_ABGR8888, 0);
+    SDL_FreeSurface(s);
+    if (!c)
+      continue;
+    size_t sz = (size_t)c->pitch * (size_t)c->h;
+    std::lock_guard<std::mutex> lk(yamiImg.mtx);
+    if (yamiImg.bytes + sz > yamiImg.budget) {
+      SDL_FreeSurface(c);
+      break; /* budget reached */
+    }
+    yamiImg.map[key] = c;
+    yamiImg.bytes += sz;
+    ++loaded;
+  }
+  Debug() << "Image cache:" << loaded << "character graphics decoded,"
+          << (int)(yamiImg.bytes >> 20) << "MB";
+}
+} // namespace
+
+static void yamiImageCacheShutdown() {
+  yamiImg.stop = true;
+  if (yamiImg.worker.joinable())
+    yamiImg.worker.join();
+  std::lock_guard<std::mutex> lk(yamiImg.mtx);
+  for (auto &e : yamiImg.map)
+    SDL_FreeSurface(e.second);
+  yamiImg.map.clear();
+  yamiImg.bytes = 0;
+  yamiImg.data.clear();
+  yamiImg.dataBytes = 0;
+}
+
+static void yamiStartPrefetch(FileSystemPrivate *p) {
+  if (yamiImg.started.exchange(true))
+    return;
+  yamiImg.budget = yamiImageBudget();
+  if (yamiImg.budget == 0 || !p->havePathCache)
+    return;
+  std::vector<std::string> files, dataFiles;
+  static const char prefix[] = "graphics/characters/";
+  static const char dprefix[] = "data/";
+  for (BoostHash<std::string, std::string>::const_iterator it = p->pathCache.cbegin();
+       it != p->pathCache.cend(); ++it) {
+    const std::string &lower = it->first;
+    size_t n = lower.size();
+    if (lower.compare(0, sizeof(dprefix) - 1, dprefix) == 0) {
+      /* maps, tilesets, events... (not the script pack: read once at boot) */
+      if (lower.find("scripts") == std::string::npos &&
+          (lower.compare(n - 7, 7, ".rxdata") == 0 || lower.compare(n - 7, 7, ".rvdata") == 0 ||
+           (n > 8 && lower.compare(n - 8, 8, ".rvdata2") == 0)))
+        dataFiles.push_back(it->second);
+      continue;
+    }
+    if (lower.compare(0, sizeof(prefix) - 1, prefix) != 0)
+      continue;
+    if (n > 4 && lower.compare(n - 4, 4, ".png") == 0)
+      files.push_back(it->second);
+  }
+  /* maps in name order: neighbours are usually numbered close together */
+  std::sort(dataFiles.begin(), dataFiles.end());
+  if (!files.empty() || !dataFiles.empty())
+    yamiImg.worker = std::thread(yamiImageWorker, std::move(dataFiles), std::move(files));
+}
+
+bool FileSystem::yamiCachedData(const char *filename, std::string &out) {
+  yamiStartPrefetch(p);
+  if (!filename || !*filename)
+    return false;
+  const std::string key = yamiImageKey(filename);
+  std::lock_guard<std::mutex> lk(yamiImg.mtx);
+  auto it = yamiImg.data.find(key);
+  if (it == yamiImg.data.end())
+    return false;
+  out = it->second;
+  return true;
+}
+
+void FileSystem::yamiForgetData(const char *filename) {
+  if (!filename || !*filename)
+    return;
+  const std::string key = yamiImageKey(filename);
+  std::lock_guard<std::mutex> lk(yamiImg.mtx);
+  yamiImg.dirty.insert(key);
+  auto it = yamiImg.data.find(key);
+  if (it == yamiImg.data.end())
+    return;
+  yamiImg.dataBytes -= it->second.size();
+  yamiImg.data.erase(it);
+}
+
+SDL_Surface *FileSystem::yamiCachedImage(const char *filename) {
+  yamiStartPrefetch(p);
+  if (!filename || !*filename)
+    return 0;
+  const std::string key = yamiImageKey(filename);
+  std::lock_guard<std::mutex> lk(yamiImg.mtx);
+  auto it = yamiImg.map.find(key);
+  if (it == yamiImg.map.end())
+    return 0;
+  return SDL_DuplicateSurface(it->second);
+}
