# Meson cross file for Android arm64. @NDK@ and @API@ are substituted by build-mkxp.sh.
[constants]
toolchain = '@NDK@/toolchains/llvm/prebuilt/linux-x86_64'
target = 'aarch64-linux-android@API@'

[binaries]
c = toolchain / 'bin' / (target + '-clang')
cpp = toolchain / 'bin' / (target + '-clang++')
ar = toolchain / 'bin' / 'llvm-ar'
strip = toolchain / 'bin' / 'llvm-strip'
ranlib = toolchain / 'bin' / 'llvm-ranlib'
nm = toolchain / 'bin' / 'llvm-nm'
objcopy = toolchain / 'bin' / 'llvm-objcopy'
pkg-config = 'false'
cmake = 'cmake'

[built-in options]
c_args = ['-fPIC', '-DANDROID', '-D__ANDROID_API__=@API@']
cpp_args = ['-fPIC', '-DANDROID', '-D__ANDROID_API__=@API@']
c_link_args = ['-static-libstdc++']
cpp_link_args = ['-static-libstdc++']
default_library = 'static'

[properties]
needs_exe_wrapper = true
sys_root = toolchain / 'sysroot'

[cmake]
# CMake subprojects (zlib, openal-soft, ...) need Android info explicitly.
CMAKE_SYSTEM_NAME = 'Android'
CMAKE_SYSTEM_VERSION = '@API@'
CMAKE_ANDROID_ARCH_ABI = 'arm64-v8a'
CMAKE_ANDROID_NDK = '@NDK@'
CMAKE_ANDROID_STL_TYPE = 'c++_static'
# Variables normally set by the NDK toolchain file; libjxl/sjpeg/highway read them.
ANDROID_ABI = 'arm64-v8a'
ANDROID_PLATFORM = 'android-@API@'
ANDROID_NDK = '@NDK@'
CMAKE_POSITION_INDEPENDENT_CODE = 'ON'

[host_machine]
system = 'android'
cpu_family = 'aarch64'
cpu = 'armv8-a'
endian = 'little'
